{
  "name": "aniskip-api",
  "version": "0.0.0-development",
  "private": true,
  "description": "Provides the opening and ending skip times for the Aniskip extension",
  "license": "MIT",
  "contributors": [
    "Lexes Jan Mantiquilla <mantiquillal@gmail.com>",
    "Dabreadman <tany3@tcd.ie>"
  ],
  "repository": "https://github.com/aniskip/aniskip-api",
  "scripts": {
    "check": "vp check",
    "check:fix": "vp check --fix",
    "db:migrate": "docker compose -f docker/docker-compose.dev.yml run --rm migrate",
    "db:new": "docker compose -f docker/docker-compose.dev.yml run --rm migrate new",
    "db:rollback": "docker compose -f docker/docker-compose.dev.yml run --rm migrate rollback",
    "db:seed": "bun run services:up && bash db/seed.sh",
    "db:status": "docker compose -f docker/docker-compose.dev.yml run --rm migrate status",
    "dev": "bun run services:up && NODE_ENV=development bun --watch src/main.ts",
    "services:down": "docker compose -f docker/docker-compose.dev.yml down",
    "services:up": "docker compose -f docker/docker-compose.dev.yml up -d --wait && bun run db:migrate",
    "start": "NODE_ENV=production bun src/main.ts",
    "test": "bun test --coverage"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/nestjs-api-reference": "1.2.30",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.5",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^7.2.1",
    "git-cliff": "2.14.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "packageManager": "bun@1.4.4"
}
