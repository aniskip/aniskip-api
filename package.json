{
  "name": "aniskip-api",
  "version": "0.0.0-development",
  "description": "Provides the opening and ending skip times for the Aniskip extension",
  "repository": "https://github.com/aniskip/aniskip-api",
  "contributors": [
    "Lexes Jan Mantiquilla <mantiquillal@gmail.com>",
    "Dabreadman <tany3@tcd.ie>"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "check": "biome check",
    "check:ci": "biome ci",
    "check:fix": "biome check --write",
    "db:migrate": "docker compose -f docker/docker-compose.dev.yml run --rm migrate",
    "db:new": "docker compose -f docker/docker-compose.dev.yml run --rm migrate new",
    "db:rollback": "docker compose -f docker/docker-compose.dev.yml run --rm migrate rollback",
    "db:seed": "bash db/seed.sh",
    "db:status": "docker compose -f docker/docker-compose.dev.yml run --rm migrate status",
    "dev": "NODE_ENV=development bun --watch src/main.ts",
    "services:down": "docker compose -f docker/docker-compose.dev.yml down",
    "services:up": "docker compose -f docker/docker-compose.dev.yml up -d && bun run db:migrate",
    "start": "NODE_ENV=production bun src/main.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/nestjs-api-reference": "1.2.30",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@nestjs/testing": "^11.2.8",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.5",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^7.2.1",
    "git-cliff": "2.14.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
