{
  "name": "aniskip-api",
  "version": "0.0.0-development",
  "description": "Provides the opening and ending skip times for the Aniskip extension",
  "repository": "https://github.com/aniskip/aniskip-api",
  "contributors": [
    "Lexes Jan Mantiquilla <mantiquillal@gmail.com>",
    "Dabreadman <tany3@tcd.ie>"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "check": "biome check",
    "check:ci": "biome ci",
    "check:fix": "biome check --write",
    "dev": "NODE_ENV=development bun --watch src/main.ts",
    "services:down": "docker compose -f docker/docker-compose.dev.yml down",
    "services:up": "docker compose -f docker/docker-compose.dev.yml up -d --build",
    "start": "NODE_ENV=production bun src/main.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^9.4.3",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^9.4.3",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/throttler": "^4.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "md5": "^2.3.0",
    "morgan": "^1.10.0",
    "nestjs-throttler-storage-redis": "^0.4.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@nestjs/testing": "^9.4.3",
    "@types/bun": "^1.4.4",
    "@types/express": "^4.17.17",
    "@types/ioredis": "^5.0.0",
    "@types/md5": "^2.3.2",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.6.1",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.4",
    "git-cliff": "2.14.2",
    "pg-mem": "^2.6.13",
    "supertest": "^6.3.3",
    "typescript": "^7.0.2",
    "uuid": "^9.0.1"
  }
}
